{"title":"RiskGuard Operations","schemaVersion":39,"version":1,"refresh":"15s","panels":[{"id":1,"type":"timeseries","title":"HTTP request rate","gridPos":{"h":8,"w":12,"x":0,"y":0},"targets":[{"expr":"sum(rate(riskguard_http_requests_total[5m])) by (method,status)"}]},{"id":2,"type":"timeseries","title":"HTTP latency p95","gridPos":{"h":8,"w":12,"x":12,"y":0},"targets":[{"expr":"histogram_quantile(0.95, sum(rate(riskguard_http_latency_seconds_bucket[5m])) by (le))"}]},{"id":3,"type":"timeseries","title":"Outbox backlog","gridPos":{"h":8,"w":12,"x":0,"y":8},"targets":[{"expr":"riskguard_outbox_backlog"}]},{"id":4,"type":"timeseries","title":"Fraud decisions","gridPos":{"h":8,"w":12,"x":12,"y":8},"targets":[{"expr":"sum(rate(riskguard_fraud_analysis_total[5m])) by (decision)"}]}]}
