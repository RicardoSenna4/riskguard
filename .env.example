# PostgreSQL (valores apenas para desenvolvimento local)
POSTGRES_DB=riskguard
POSTGRES_USER=riskguard
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
# Fraud Service database on the same PostgreSQL instance (database-per-service).
# The password is embedded in a connection URL, so avoid URL-reserved characters (@ : / ? #).
FRAUD_DB_NAME=riskguard_fraud
# Transaction Service
DB_HOST=localhost
DB_PORT=5432
DB_NAME=riskguard
DB_USERNAME=riskguard
DB_PASSWORD=change-me-local-only
SERVER_PORT=8080
# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PORT_HOST=6379
# Kafka / KRaft
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_EXTERNAL_PORT=9092
KAFKA_UI_PORT=8081
# Authentication: replace with `openssl rand -base64 32`; 32+ random bytes, Base64.
JWT_SECRET=REPLACE_WITH_BASE64_ENCODED_RANDOM_32_BYTES
JWT_ACCESS_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_SECONDS=604800
# Fraud Service
RISK_ENGINE=rules
# Frontend (future)
VITE_API_BASE_URL=http://localhost:8080/api/v1
